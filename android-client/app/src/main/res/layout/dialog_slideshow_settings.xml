<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <CheckBox
            android:id="@+id/check_slideshow_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启用幻灯片播放"
            android:textColor="#00E5FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="屏幕无触摸后进入幻灯片"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_slideshow_idle_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="秒"
            android:inputType="number"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="每张幻灯片显示时间"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_slide_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="秒"
            android:inputType="number"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="画面显示方式"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/group_slideshow_display_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_slideshow_fit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="全图展示（完整显示，可能留边）"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/radio_slideshow_fill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="全屏展示（铺满屏幕，可能裁剪）"
                android:textColor="@color/text" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/check_slideshow_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="图片上显示实时时间"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/check_slideshow_move_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:text="时间屏保移动（斜向移动，碰边反弹）"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/check_slideshow_thumbnails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="底部显示可左右滑动的图片列表"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="滑动底部列表浏览，轻触小图切换；轻触大图退出幻灯片。"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/check_slideshow_cache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="缓存幻灯片到平板"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/text_slideshow_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
