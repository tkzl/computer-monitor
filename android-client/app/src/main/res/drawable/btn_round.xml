<?xml version="1.0" encoding="utf-8"?>
<!-- HUD 按钮：常态细描边，按下霓虹反色，禁用态半透明 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_glow_strong" />
            <stroke android:width="1dp" android:color="@color/hud_line_bright" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#3304070F" />
            <stroke android:width="1dp" android:color="#3300E5FF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8804070F" />
            <stroke android:width="1dp" android:color="#6600E5FF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
