<?xml version="1.0" encoding="utf-8"?>
<!-- HUD 方形按钮：细描边 + 按下霓虹反色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_glow" />
            <stroke android:width="1dp" android:color="@color/hud_line_bright" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1400E5FF" />
            <stroke android:width="1dp" android:color="#5900E5FF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
