<?xml version="1.0" encoding="utf-8"?>
<!-- 关闭按钮背景：常态霓虹细描边圆环，按下圆内点亮青色光晕 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/hud_glow_strong" />
            <stroke android:width="1dp" android:color="@color/hud_line_bright" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#2204070F" />
            <stroke android:width="1dp" android:color="#3300E5FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#330A1420" />
            <stroke android:width="1dp" android:color="#6600E5FF" />
        </shape>
    </item>
</selector>
