<?xml version="1.0" encoding="utf-8"?>
<!-- HUD 面板：深空渐变底 + 霓虹细描边（角标矢量会被拉伸，改由布局层控制） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/hud_panel_bottom"
                android:startColor="@color/hud_panel_top" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/hud_line" />
        </shape>
    </item>
</layer-list>
