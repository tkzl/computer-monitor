<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底槽：深空色 + 细描边 -->
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/hud_track" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="@color/hud_line" />
        </shape>
    </item>
    <!-- 进度：蓝→青→绿霓虹渐变 -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient
                    android:angle="0"
                    android:startColor="@color/hud_blue"
                    android:centerColor="@color/accent"
                    android:endColor="@color/hud_green" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
